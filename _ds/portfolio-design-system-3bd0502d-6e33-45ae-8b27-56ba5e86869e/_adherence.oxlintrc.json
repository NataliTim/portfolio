{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/layout/**",
              "components/navigation/**",
              "ui_kits/portfolio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Public Sans|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Public Sans, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|href|icon|iconPosition|disabled|fullWidth|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, href, icon, iconPosition, disabled, fullWidth, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|cyan|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'cyan' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='iconPosition'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Button> iconPosition must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaseStudyCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|subtitle|image|imageAlt|categories|platforms|stack|href|stat|style|key|ref|className|style|children)$/]",
        "message": "<CaseStudyCard> doesn't accept that prop. Declared props: index, title, subtitle, image, imageAlt, categories, platforms, stack, href, stat, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaseStudy'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|subtitle|image|imageAlt|categories|platforms|stats|challenge|solution|technical|results|stack|cta|key|ref|className|style|children)$/]",
        "message": "<CaseStudy> doesn't accept that prop. Declared props: index, title, subtitle, image, imageAlt, categories, platforms, stats, challenge, solution, technical, results, stack, cta."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:headline|email|blurb|columns|colophon|copyright|style|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: headline, email, blurb, columns, colophon, copyright, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GridOverlay'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|fade|columns|opacity|style|key|ref|className|style|children)$/]",
        "message": "<GridOverlay> doesn't accept that prop. Declared props: size, fade, columns, opacity, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|accent|subtitle|meta|actions|tags|grid|style|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: eyebrow, title, accent, subtitle, meta, actions, tags, grid, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|title|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|name|type|placeholder|value|defaultValue|onChange|hint|error|required|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, name, type, placeholder, value, defaultValue, onChange, hint, error, required, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Nav'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|brandHref|links|active|cta|sticky|onThemeToggle|style|key|ref|className|style|children)$/]",
        "message": "<Nav> doesn't accept that prop. Declared props: brand, brandHref, links, active, cta, sticky, onThemeToggle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Reveal'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|delay|distance|once|style|key|ref|className|style|children)$/]",
        "message": "<Reveal> doesn't accept that prop. Declared props: children, delay, distance, once, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|subtitle|kicker|level|rule|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: index, title, subtitle, kicker, level, rule, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignupForm'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|placeholder|buttonLabel|note|count|onSubmit|style|key|ref|className|style|children)$/]",
        "message": "<SignupForm> doesn't accept that prop. Declared props: title, description, placeholder, buttonLabel, note, count, onSubmit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|sublabel|accent|size|align|style|key|ref|className|style|children)$/]",
        "message": "<StatBlock> doesn't accept that prop. Declared props: value, label, sublabel, accent, size, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:green|cyan|none)$/]",
        "message": "<StatBlock> accent must be one of 'green' | 'cyan' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<StatBlock> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<StatBlock> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|platform|icon|size|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, platform, icon, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|green|cyan|solid)$/]",
        "message": "<Tag> tone must be one of 'neutral' | 'green' | 'cyan' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='platform'] > Literal[value!=/^(?:web|ios|android|desktop|saas|api)$/]",
        "message": "<Tag> platform must be one of 'web' | 'ios' | 'android' | 'desktop' | 'saas' | 'api'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Tag> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:period|role|org|location|description|tags|current|key|ref|className|style|children)$/]",
        "message": "<TimelineItem> doesn't accept that prop. Declared props: period, role, org, location, description, tags, current."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
